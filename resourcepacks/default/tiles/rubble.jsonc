// Rubble: the broken stone left once a player harvested cracked rock (#1546) by hand; copper ore
// leaves its own (copper_ore_rubble, #2572). Nobody walks it, and sight passes over it, like the
// rock was. It lasts until its instance is purged (#212), which brings the rock back.
{
	"id": "rubble",
	"color": "#ada393",
	"symbol": "+", // tells it apart without its color (#68)
	"model": "model_rock_single_a", // a low broken stone (#68)
	"scale": 400, // in hundredths: the pack's stone is too small to read from the camera
	"traits": { "walkable": false }
}
