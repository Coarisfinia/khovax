// The tonic (#2090), the first potion of the design on #2049: a vial crafted at the base and drunk
// for the out companion (a tonic) or for the player (a draught). Dew carries it, one primary sets
// its effect, and at most one trait sets its trade-off; crystal goes only into a Shared brew. Rock,
// ore, metal and hide are never brewed (#2038). Every brew the design's table allows is listed, with
// its cost and values: potency in thousandths, durations in seconds. Placeholders, to tune (#960).
{
	"id": "tonic",
	"carrier": "dew",
	"catalyst": "crystal",
	"primaries": { "berry": "mend", "moss": "regrowth", "pondweed": "ward", "feather": "quicken", "bone": "fortify" },
	"traits": ["none", "strong", "lasting", "shared", "slow_release"],
	"targets": { "companion": "tonic", "player": "draught" },
