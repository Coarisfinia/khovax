// A placeholder harvest table (#687): what a felled moss toad drops, apart from what dominating it
// gives. Mostly hide, sometimes a bone, else a blank, which rolls on the instance's table instead.
{
	"id": "moss_toad",
	"kind": "harvest",
	"entries": [
		{ "item": "hide", "chance": 600, "min": 1, "max": 2 }, // 60 %
		{ "item": "bone", "chance": 200, "min": 1, "max": 1 }, // 20 %
		{ "blank": true, "chance": 200 }
	]
}
