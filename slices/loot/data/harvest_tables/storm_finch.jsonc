// A placeholder harvest table (#687): what a felled storm finch drops. Mostly feathers, sometimes a
// bone, else a blank, which rolls on the instance's table instead.
{
	"id": "storm_finch",
	"kind": "harvest",
	"entries": [
		{ "item": "feather", "chance": 600, "min": 2, "max": 4 }, // 60 %
		{ "item": "bone", "chance": 200, "min": 1, "max": 1 }, // 20 %
		{ "blank": true, "chance": 200 }
	]
}
