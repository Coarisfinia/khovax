// The Cartographer's Guild (#484), the starter faction that accompanies the player on the main
// quest: it strives to chart the world, explore it and raid its dungeons. An Apprentice Charter once
// they join, rising with the story's quests until the guild writes their name onto its charts.
// Betrayer when a path turns against it, then struck from its records and marked as a danger on
// its charts.
{
	"id": "cartographers_guild",
	"name": "Cartographer's Guild",
	"symbol": "+", // a compass's cross, which marks its territory (#68)
	"ranks_up": [
		"Apprentice Charter",
		"Wayfinder",
		"Pathmaker",
		"Master Cartographer",
		"Charted in Legend"
	],
	"ranks_down": [
		"Betrayer",
		"Struck from the Ledger",
		"Uncharted",
		"Marked Hazard",
		"Edge of the Chart"
	],
	// The guild's home, the glade, where the player starts (#637, #712).
	"territory": ["glade"]
}
