// A territory quest (#638): the Cartographer's Guild takes the outpost southeast of its glade. It
// starts once the player first enters the outpost, and asks them to stand on both its holds, then
// climb to its watch, from where the guild can see the whole outpost; finishing it hands the
// outpost to the guild. Holding a hold against others comes with the control points (#643).
{
	"id": "guild_holds_the_outpost",
	"name": "Hold the outpost for the Guild",
	"starts_on": { "condition": "entered", "instance": "outpost" },
	"territory": { "instance": "outpost", "faction": "cartographers_guild" },
	"steps": [
		{ "condition": "reached", "place": "outpost_north_hold", "instance": "outpost" },
		{ "condition": "reached", "place": "outpost_south_hold", "instance": "outpost" },
		{ "condition": "entered", "piece": "watch", "instance": "outpost", "ends": "guild_holds_the_outpost" }
	]
}
