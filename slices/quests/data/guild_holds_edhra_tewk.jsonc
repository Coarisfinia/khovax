// A territory quest (#638): the Amvrel Velmarai take Edhra Tewk, southeast of Lumwen Hoal. It
// starts once the player first enters Edhra Tewk, and asks them to stand on both its holds, then
// climb to its watch, from where the guild can see the whole outpost; finishing it hands
// Edhra Tewk to the guild. Holding a hold against others comes with the control points (#643).
{
	"id": "guild_holds_edhra_tewk",
	"name": "Hold Edhra Tewk for the ${FACTION:amvrel_velmarai}",
	"starts_on": { "condition": "entered", "instance": "edhra_tewk" },
	"territory": { "instance": "edhra_tewk", "faction": "amvrel_velmarai" },
	"steps": [
		{ "condition": "reached", "place": "north_hold", "instance": "edhra_tewk" },
		{ "condition": "reached", "place": "south_hold", "instance": "edhra_tewk" },
		{ "condition": "entered", "piece": "watch", "instance": "edhra_tewk", "ends": "guild_holds_edhra_tewk" }
	]
}
