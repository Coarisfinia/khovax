// A scout of the Cartographer's Guild (#484) greets the player (#618): the first dialog, until an
// NPC (#557) speaks it. Asking about the glade leads on; either farewell ends it.
{
	"id": "guild_scout_greeting",
	"speaker": "Guild Scout",
	"lines": [
		{ "text": "Careful where you step. The ground here hasn't been charted yet." },
		{
			"text": "The Guild pays well for anyone who walks the wild places and comes back to tell of them.",
			"answers": [
				{ "id": "ask_about_glade", "text": "What lies ahead?", "next": "glade" },
				{ "id": "leave_scout", "text": "I'll find my own way." }
			]
		},
		{
			"id": "glade",
			"text": "A glade, thick with ${MONSTER:moss_toad}. Something has soured it lately; they won't sit still.",
			"answers": [{ "id": "promise_to_look", "text": "I'll take a look." }]
		}
	]
}
