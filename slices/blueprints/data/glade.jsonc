// The first region arranged from region pieces (#57): a glade the seed puts together, where the
// world starts (#712).
{
	"id": "glade",
	"features": [
		"movement", "knockdown", "trail", "health", "domination", "wild_attacks", "spikes",
		"domination_loot", "enrage", "fog", "companions", "companion_swaps", "revive_items",
		"type_effectiveness", "companion_attacks", "specials", "harvest", "dialogs", "territory"
	],
	"loot_table": "glade",
	"chest_table": "glade_chest",
	"wild_species": { "ombulumo": 1 },
	"variants": [
		// Once its corrupting monster faints, it emits glade_purified (regions/glade_corrupted.md),
		// which purifies it: the glade again.
		{ "flag": "EVENT_EMITTED_glade_purified", "region": "" },
		// Corrupted (#541), a placeholder region until the corrupted instances' own arrive.
		{ "flag": "glade_corrupted", "region": "glade_corrupted" }
	]
}
