# Godot
.godot/
.import/
export_presets.cfg.local
*.translation

# Builds (Godot's relative export paths are the project's, #1101)
/src/game/build/
/src/game/export/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
*.tmp

# A local render's window settings (AGENTS.md, "Before you push"); never committed.
/src/game/override.cfg

# uv's environment for the Python tooling (pyproject.toml)
.venv/
# Python bytecode from the Blender model scripts (src/game-models/lib/).
__pycache__/

# The default pack's .pck a build carries (#1941): CI builds it before exporting.
/src/game/packs/

# The game's link to the resource packs at the root (#1978), made by
# src/game-build/link_resource_packs.py: a symlink, or on Windows a junction.
/src/game/resourcepacks
