# The project watcher's settings here (`Flixbox/household-brain#241`), read by the plugin's monitor and by
# `bun --env-file=.claude/watcher.env`; the environment still wins. OWNER (the owner's login, whose
# approval counts) isn't set here: the watcher finds the organisation's one human admin itself
# (`Flixbox/household-brain#296`), and OWNER only overrides that.
# The agent works on GitHub as the bot (see AGENTS.md).
REPO=Coarisfinia/khovax
WORKFLOW=ci.yml
GH=agent-gh
ACTIVITY_GH=gh
SELF=coarisfinia-ai-agent[bot]
# Dismiss a bot's change request (any login ending in [bot], here CodeRabbit's) once the owner
# approved, CI is green and every review thread is settled: one left on an older commit, or one on
# the head once `Resolved:` replies settled it (#1551, `Flixbox/household-brain#285`,
# `Flixbox/household-brain#290`). It reports REVIEW_DISMISSED. A person's is never dismissed.
DISMISS_STALE_BOT_REVIEWS=1
# Hold READY_TO_MERGE for a draft the owner approved until CodeRabbit has reviewed its head
# (`Flixbox/household-brain#299`).
REVIEW_BOTS=coderabbitai
# Mark a draft ready once the owner approved its head; it reports DRAFT_READIED (#1667,
# `Flixbox/household-brain#301`, `Flixbox/household-brain#316`).
READY_APPROVED_DRAFTS=1
# Post `@coderabbitai resolve` once CodeRabbit's change request on the head is settled (every thread
# resolved, CI green), whatever the merge risk; it reports BOT_RESOLVE_ASKED (#1603,
# `Flixbox/household-brain#304`).
RESOLVE_BOT_REVIEWS=coderabbitai
# The label the main session puts on a PR a review subagent cleared; with DISMISS_STALE_BOT_REVIEWS
# the watcher dismisses the bot change requests submitted before it was last put on, once their
# threads are settled by `Resolved:` replies (#1803, `Flixbox/household-brain#331`). Its default, set
# here so the file holds them all.
CLEARED_LABEL=subagent-cleared
