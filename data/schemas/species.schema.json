{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://github.com/Flixbox/khovax/data/schemas/species.schema.json",
	"title": "Species",
	"description": "What a monster is, captured or not (#45, #72). One file per species, named after its id.",
	"type": "object",
	"additionalProperties": false,
	"required": ["id", "types", "hp", "strength"],
	"properties": {
		"id": {
			"description": "Stable, never reused: lowercase words joined by underscores.",
			"type": "string",
			"pattern": "^[a-z][a-z0-9_]*$"
		},
		"types": {
			"description": "One or two types from the type chart (#68), never two of the same family.",
			"type": "array",
			"minItems": 1,
			"maxItems": 2,
			"uniqueItems": true,
			"items": {
				"enum": ["mana", "arcane", "shadow", "abyss", "might", "titan", "growth", "nature", "breeze", "tempest"]
			}
		},
		"hp": { "description": "Base HP, a whole amount (#33).", "type": "integer", "minimum": 1, "maximum": 1000000000 },
		"strength": { "description": "Base strength, a whole amount (#33).", "type": "integer", "minimum": 1, "maximum": 1000000000 }
	}
}
