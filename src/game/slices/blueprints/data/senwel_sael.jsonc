{
	"id": "senwel_sael",
	"name": "Senwel Sael",
	"codex": {
		"entry": "A small, quiet ground by a still pool, where only the world's testers walk. Soft sounds for a calm place; Sael is still water.",
		"gloss": "the quiet pool"
	},
	"rules": "standard",
	"debug_zone": true,
	"loot_table": "wild_ground",
	"wild_species": { "ombulumo": 3, "tikazzir": 1 }
}
