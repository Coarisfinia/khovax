// The tadpole's self passive (#1737): a smaller guard than the Ombulumo's Bolmu-wolmu. Its guard is
// a placeholder to tune (#960).
{
	"id": "wobulumu_lobbu_wobbu",
	"kind": "self_passive",
	"name": "Lobbu-wobbu",
	"description": "The ${MONSTER:wobulumu}'s slippery little body slips out from under part of every hit.",
