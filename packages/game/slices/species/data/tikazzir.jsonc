/* A placeholder dual-type species: quick and frail. Breeze and Mana come from two different
   families, as dual types must. */
{
	"id": "tikazzir",
	"name": "Tikazzir",
	"codex": {
		"entry": "A small, quick flier with sharp eyes that darts low between the reeds and clicks as it turns, gone before it can be struck. Its name is a beast-call, the sound it makes: the clicks of its turns in t and k, and the buzz of its wings in the doubled z.",
		"gloss": "the click and buzz in the reeds"
	},
	"types": ["breeze", "mana"],
	"strike_type": "breeze",
	"hp": 60,
	"strength": 70,
	"speed": 90,
	"special": "tikazzir_tizik_tazak",
	"player_passive": "tikazzir_kirzi_tirzi",
	"self_passive": "tikazzir_zirki_kirki",
	"sight": 2, // its keen eyes: its player sees further (#962)
	/* Its sharp eyes hunt by day, darting after prey with others of its kind (#1200). Quick and
	   frail, it sleeps lightly: a player stepping next to it wakes it (#1230). */
	"behaviour": ["diurnal", "predator", "pack_species", "light_sleeper"],
	"model": "model_mana_wolf" // the mana wolf stands in until it has its own model (#1223)
}
