// The arcane wolf (#1167): the ascended form of the mana pups (#1219, #1220), so it has mana's
// Greater type, arcane. It wears the mana wolf's model (#990). Its stats are placeholders to tune
// (#960).
{
	"id": "vynakiir",
	"name": "Vynakiir",
	"codex": {
		"entry": "A lean wolf of the high passes with a crystal on its brow and a crown of wisps turning above its head: a mana pup grown, whose crystal has hardened and whose mana has deepened into the arcane. It hunts by holding its prey still: it hums low while its crown closes on it, then snaps. Its name is a beast-call, the sound it makes: the hum in v, n and y, the howl that carries in its long ii, and the snap of its jaw in the k.",
		"gloss": "the hum that holds, then the howl"
	},
	"types": ["arcane"],
	"strike_type": "arcane",
	"hp": 90,
	"strength": 55,
	"speed": 60,
	"special": "vynakiir_vunnu_vinni",
	"player_passive": "vynakiir_kynri_vynri",
	"self_passive": "vynakiir_nyvik_ryvik",
	"behaviour": ["nocturnal", "predator", "pack_species"], // a wolf: hunts at night, in packs (#1200)
	"model": "res://assets/mana-wolf/mana_wolf.glb"
}
