// The tadpole (#1737): the Ombulumo's first form, wearing its own model, from the owner's model. It
// spawns as the Ombulumo's baby in wild bundles (#1697) and ascends into the bud, an Ombuwomo
// (#1738), once it has reached its level and is given pondweed. Its level and stats are
// placeholders to tune (#960).
{
	"id": "wobulumu",
	"name": "Wobulumu",
	"codex": {
		"entry": "A round little tadpole of the Ombulumo, all head and belly, with a soft fin on its tail and a row of pale spots along each side. It wriggles over the wet ground of the shallows and nibbles at the weed there, and in time it ascends into an Ombulumo. Its name is a beast-call, the sound of it: the Ombulumo's round b, m and l with a wobble in front, for a little thing that wriggles.",
		"gloss": "the little wobble that will boom"
	},
	"types": ["growth"],
	"strike_type": "growth",
	"hp": 70,
	"strength": 25,
	"speed": 50,
	"special": "wobulumu_wublu_wobla",
	"player_passive": "wobulumu_lummu_wummu",
	"self_passive": "wobulumu_lobbu_wobbu",
	// A tadpole of the shallows, awake by night with its elders: it nibbles weed and keeps near water (#1200).
	"behaviour": ["nocturnal", "grazer", "drinker"],
	"model": "res://assets/wobulumu/wobulumu.glb",
	"ascension": { "into": "ombuwomo", "level": 20, "material": "pondweed" }
}
