// Hrovumel Stolm, the dungeon behind the escort guide's seal (#1591, #1553): Vis'omera is found at
// its end, the shrine (#1592). Ardvaun draws it southwest of Brekhal Varn, and its way in leads back
// out through the guide's seal there (#1590).
{
	"id": "hrovumel_stolm",
	"codex": {
		"entry": "A stronghold sunk into the rock, shut for so long that nobody living remembers its halls, until a guide opens the way. Its name is hushed: a breathy hr, then round o, u and soft m and l, like air moving through a closed hall; Stolm is a stronghold.",
		"gloss": "the hushed stronghold"
	},
	"rules": "standard",
	"loot_table": "wild_ground",
	"wild_species": { "tikazzir": 2, "vynakiir": 1 }
}
