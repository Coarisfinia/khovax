// Teska na Amvrel, a scout of the Amvrel Velmarai (#484, #976, #977), greets the player (#618),
// who talks to them east of Lumwen Hoal's start (#557). Asking about Lumwen Hoal leads on; either
// farewell ends it.
{
	"id": "teska_na_amvrel_greeting",
	"speaker": "teska_na_amvrel",
	"lock": false,
	"lines": [
		{ "text": "Careful where you step. The ground here hasn't been charted yet." },
		{
			"text": "The ${FACTION:amvrel_velmarai} pay well for anyone who walks the wild places and comes back to tell of them.",
			"answers": [
				{ "id": "ask_about_lumwen_hoal", "text": "What lies ahead?", "next": "lumwen_hoal" },
				{ "id": "leave_scout", "text": "I'll find my own way." }
			]
		},
		{
			"id": "lumwen_hoal",
			"text": "Lumwen Hoal, thick with ${MONSTER:ombulumo}. Something has soured it lately; they won't sit still.",
			"answers": [{ "id": "promise_to_look", "text": "I'll take a look.", "commits": true }]
		}
	]
}
