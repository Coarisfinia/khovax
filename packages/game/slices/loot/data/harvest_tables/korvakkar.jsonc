// A placeholder harvest table (#687, #1771): what a felled Korvakkar drops, apart from what
// dominating it gives. Mostly hide, sometimes a bone, now and then a shard of its basalt, else a
// blank, which rolls on the instance's table instead.
{
	"id": "korvakkar",
	"kind": "harvest",
	"entries": [
		{ "item": "hide", "chance": 500, "min": 1, "max": 2 }, // 50 %
		{ "item": "bone", "chance": 200, "min": 1, "max": 1 }, // 20 %
		{ "item": "stone", "chance": 100, "min": 1, "max": 2 }, // 10 %
		{ "blank": true, "chance": 200 }
	]
}
