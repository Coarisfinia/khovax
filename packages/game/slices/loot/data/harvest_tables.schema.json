{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://github.com/Coarisfinia/khovax/slices/loot/data/harvest_tables.schema.json",
	"title": "Harvest table",
	"description": "What a wild monster felled by a companion's special drops (#629, #687), apart from what dominating it gives (loot_tables). Rolled like a species loot table (#90): its one blank entry rolls again on the instance's table. Chances are thousandths and add up to 1000 (100 %). One file per species, named after the species id.",
	"type": "object",
	"additionalProperties": false,
	"required": ["id", "kind", "entries"],
	"properties": {
		"id": {
			"description": "The species' id: lowercase words joined by underscores.",
			"type": "string",
			"pattern": "^[a-z][a-z0-9_]*$"
		},
		"kind": {
			"description": "Always a harvest table.",
			"const": "harvest"
		},
		"entries": {
			"type": "array",
			"minItems": 1,
			"items": {
				"oneOf": [
					{
						"description": "An item, in an amount rolled from min to max.",
						"type": "object",
						"additionalProperties": false,
						"required": ["item", "chance", "min", "max"],
						"properties": {
							"item": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
							"chance": { "description": "In thousandths.", "type": "integer", "minimum": 1, "maximum": 1000 },
							"min": { "type": "integer", "minimum": 1, "maximum": 1000000000 },
							"max": { "type": "integer", "minimum": 1, "maximum": 1000000000 }
						}
					},
					{
						"description": "The blank: a roll on the instance's table instead.",
						"type": "object",
						"additionalProperties": false,
						"required": ["blank", "chance"],
						"properties": {
							"blank": { "const": true },
							"chance": { "description": "In thousandths.", "type": "integer", "minimum": 1, "maximum": 1000 }
						}
					}
				]
			}
		}
	}
}
