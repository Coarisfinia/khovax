// What Brekhal Varn's chest holds (#694), a placeholder to tune (#960): crafting supplies, stone of
// the pass, sometimes a piece of basic gear, and more often than its ground the rime shard a
// Kavrikka needs to ascend (#1733, #1260) and the wind ribbon a Tikazzelu needs (#1732). Always
// something, never nothing.
{
	"id": "pass_chest",
	"kind": "chest",
	"entries": [
		{ "item": "moss", "chance": 150, "min": 1, "max": 3 },
		{ "item": "berry", "chance": 200, "min": 1, "max": 2 },
		{ "item": "stone", "chance": 200, "min": 1, "max": 2 },
		{ "item": "warding_charm", "chance": 50, "min": 1, "max": 1 },
		{ "item": "thorn_spikes", "chance": 50, "min": 1, "max": 1 },
		{ "item": "berry_pouch", "chance": 50, "min": 1, "max": 1 },
		{ "item": "revive_herb", "chance": 50, "min": 1, "max": 1 },
		{ "item": "rime_shard", "chance": 150, "min": 1, "max": 1 }, // 15 %
		{ "item": "wind_ribbon", "chance": 100, "min": 1, "max": 1 } // 10 %
	]
}
