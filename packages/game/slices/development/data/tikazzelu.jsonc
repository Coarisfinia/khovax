// Tikazzelu's development web (#677, #1732): a ribbon sprite, it leans into its quickness and its
// dart and may grow toward its elder's sharp strikes; its flock's deepest node grants a stronger
// special. Its shifts and its stronger special are placeholders to tune (#960).
{
	"species": "tikazzelu",
	// Around the web: each direction sits beside the ones before and after it, the last beside the
	// first.
	"directions": [
		{ "id": "fluttering", "nodes": [
			{ "leaning": { "speed": 50 } },
			{ "leaning": { "speed": 60 } },
			{ "leaning": { "speed": 80, "hp": -30 } }
		] },
		{ "id": "darting", "nodes": [
			{ "leaning": { "strength": 50 } },
			{ "leaning": { "strength": 60, "speed": 20 } },
			{ "leaning": { "strength": 80, "hp": -30 } }
		] },
		{ "id": "woven", "nodes": [
			{ "leaning": { "hp": 50 } },
			{ "leaning": { "hp": 60, "speed": -20 } },
			{ "leaning": { "hp": 80, "strength": -30 } }
		] },
		{ "id": "flock", "nodes": [
			{ "leaning": { "strength": 30, "speed": 30 } },
			{ "leaning": { "strength": 40, "speed": 40, "hp": -20 } },
			{ "leaning": { "strength": 60, "speed": 60, "hp": -40 } },
			{ "special": 200 }
		] }
	],
	"bridges": [["fluttering_2", "darting_2"], ["woven_1", "flock_1"]],
	"portals": [["fluttering_3", "woven_3"]]
}
