// Kalvrakkor's development web (#677, #1685): a heavy hound of frost and fire, it leans into its
// bite and its bulk, and may grow quicker. Its shifts and its stronger special are placeholders to
// tune (#960); its deepest nodes grant a stronger special.
{
	"species": "kalvrakkor",
	// Around the web: each direction sits beside the ones before and after it, the last beside the
	// first.
	"directions": [
		{ "id": "molten", "nodes": [
			{ "leaning": { "strength": 50 } },
			{ "leaning": { "strength": 60 } },
			{ "leaning": { "strength": 80, "speed": -30 } },
			{ "special": 200 }
		] },
		{ "id": "frozen", "nodes": [
			{ "leaning": { "hp": 60 } },
			{ "leaning": { "hp": 60, "strength": 20 } },
			{ "leaning": { "hp": 100, "speed": -30 } }
		] },
		{ "id": "swift", "nodes": [
			{ "leaning": { "speed": 50 } },
			{ "leaning": { "speed": 60, "hp": -20 } },
			{ "leaning": { "speed": 80, "strength": -30 } }
		] },
		{ "id": "hunter", "nodes": [
			{ "leaning": { "strength": 30, "speed": 30 } },
			{ "leaning": { "strength": 40, "speed": 40, "hp": -20 } },
			{ "leaning": { "strength": 60, "speed": 60, "hp": -40 } }
		] }
	],
	"bridges": [["molten_2", "frozen_2"], ["swift_1", "hunter_1"]],
	"portals": [["molten_3", "swift_3"]]
}
