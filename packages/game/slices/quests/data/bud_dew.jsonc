// The buds' quest (#1738, source 4 of #1260, as the mana pups' #1348): a side quest that starts once
// the player first enters Lumwen Hoal, where the Ombulumo live, and asks them to dominate one of
// them there. Finishing it hands over the dew a bud needs to ascend.
{
	"id": "bud_dew",
	"name": "Dew for an ${MONSTER:ombuwomo}",
	"starts_on": { "condition": "entered", "instance": "lumwen_hoal" },
	"steps": [{ "condition": "dominated", "species": "ombulumo", "instance": "lumwen_hoal", "ends": "bud_dew" }],
	"materials": { "dew": 1 }
}
