// Copper ore: an outcrop of broken stone with copper in its cracks, in the mountains (#1929).
// Nobody walks it, but sight passes over it, like a boulder. Its copper veins tell it apart from
// the rock walls besides its color (#68). A player next to it breaks the copper out by hand, which
// leaves rubble.
{
	"id": "copper_ore",
	"color": "#8a6a52",
	"symbol": "$", // tells it apart without its color (#68)
	"model": "model_ore_outcrop",
	"harvest": { "yields": "copper_veins", "becomes": "rubble", "takes": "hands" },
	"traits": { "walkable": false }
}
